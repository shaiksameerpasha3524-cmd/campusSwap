# ==========================================
# CAMPUSSWAP ENVIRONMENT VARIABLES CONFIG
# Rename this file to .env and insert keys
# ==========================================

# Supabase Configurations
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Razorpay Payment Gateway Configurations
# Create a test account on Razorpay and generate API Keys in Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyId
